# Supabase Configuration (Required for Persistent Database)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_key

# Google Gemini API Key (Required for AI Triage)
GEMINI_API_KEY=your_gemini_api_key

# Google reCAPTCHA v3 (Required for authentication)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret

# Sightengine Image Moderation Credentials (Optional)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Pinecone Vector Search Credentials (Optional)
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=

# CLIP / Image Embedding API Key (Optional)
CLIP_EMBEDDING_API_KEY=

# Spam Detection Thresholds (Optional Defaults)
PHASH_DISTANCE_THRESHOLD=5
DUPLICATE_RADIUS_METERS=100
DUPLICATE_TIME_WINDOW_MINUTES=60
